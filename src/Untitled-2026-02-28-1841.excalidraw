      "versionNonce": 749524094,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774039500637,
      "link": null,
      "locked": false,
      "text": "4 bytes: magic number;\n2 bytes: version number;\n2 bytes: main function entry index;\n2 bytes: function count;\n2 bytes: type table length;\n2 bytes: constant count;\n2 bytes: native Function count;\n\n// type id nicht gebraucht gleich mit position\ntype table:\n1 byte: typeKind;\n2 bytes: element type when null: 0xFFFF;\n2 bytes:  name lenght;\nname length bytes: name;\n\nconstant pool:\n1 byte: value type;\n8 bytes: value; \n\nfunction pool:\n2 bytes: localCount;\n2 bytes: paramCount;\n2 bytes: maxRegCount;\n4 bytes: bytecode Length;\nbytecode length bytes: bytecode;\nStackMap:\n    4 bytes: stackMapCount; \n    2 bytes: regWordCount;\n    2 bytes: localWordCount;\n    per stackmap:\n        4 bytes byteOffset;\n        8 byte * wordCount: liveReg;\n        8 byte * wordCount: liveLocal;\n        \n\n\nnative Function Names:\n2 bytes name length;\nname length bytes: name;\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 bytes: magic number;\n2 bytes: version number;\n2 bytes: main function entry index;\n2 bytes: function count;\n2 bytes: type table length;\n2 bytes: constant count;\n2 bytes: native Function count;\n\n// type id nicht gebraucht gleich mit position\ntype table:\n1 byte: typeKind;\n2 bytes: element type when null: 0xFFFF;\n2 bytes:  name lenght;\nname length bytes: name;\n\nconstant pool:\n1 byte: value type;\n8 bytes: value; \n\nfunction pool:\n2 bytes: localCount;\n2 bytes: paramCount;\n2 bytes: maxRegCount;\n4 bytes: bytecode Length;\nbytecode length bytes: bytecode;\nStackMap:\n    4 bytes: stackMapCount; \n    2 bytes: regWordCount;\n    2 bytes: localWordCount;\n    per stackmap:\n        4 bytes byteOffset;\n        8 byte * wordCount: liveReg;\n        8 byte * wordCount: liveLocal;\n        \n\n\nnative Function Names:\n2 bytes name length;\nname length bytes: name;\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
