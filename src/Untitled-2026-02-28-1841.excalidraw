      "updated": 1772816020404,
      "link": null,
      "locked": false,
      "text": "If Statement in Bytecode:\n\nLOAD_LOCAL, r0 , local[1]\nLOAD_CONST, r1, const[1]\nCMP_EQ_INT, r2 , r0, r1\nJUMP_IF_FALSE, {berechneter offset + label_name}, r2\nLOAD_CONST, r3 ,const[2]\nRETURN 10,\nLabelEnd;    \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If Statement in Bytecode:\n\nLOAD_LOCAL, r0 , local[1]\nLOAD_CONST, r1, const[1]\nCMP_EQ_INT, r2 , r0, r1\nJUMP_IF_FALSE, {berechneter offset + label_name}, r2\nLOAD_CONST, r3 ,const[2]\nRETURN 10,\nLabelEnd;    \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
